{
  "rulebook_path": "docs/ENGINEERING_RULES.md",
  "standards_path": "docs/CONVENTION.md",
  "context_file": "AGENTS.md",

  "repos": [
    { "name": "app", "root": "." }
  ],

  "test_command": "pytest",

  "tickets_dir": "docs/tasks",
  "work_dir": "docs/tasks",
  "work_doc_mode": "embed",

  "pr_checklist_path": null,
  "stuck_threshold": 3,
  "explore_fanout": true,

  "track": "backend",
  "breakpoints": null,
  "design_doc_path": "DESIGN.md",
  "cost_tier": "standard",

  "token_optimizer": {
    "rtk": "expect",
    "headroom": { "enabled": false, "output_shaper": false },
    "caveman": { "enabled": false, "scope": "non-critic-only" }
  },

  "update_check_url": "https://raw.githubusercontent.com/cuongdinhngo/mango-plugins/main/.claude-plugin/marketplace.json",
  "branch_strategy": "feat|fix|chore|docs/<NNN>-<slug>",
  "lessons_path": "docs/LESSONS.md",
  "agent_brief_path": "docs/AGENT_BRIEF.md",
  "skill_gap_path": "docs/SKILL_GAP_CANDIDATES.md",
  "gotchas_path": "docs/gotchas.md",
  "drift_path": "docs/DRIFT.md",
  "pr_host": "gh",

  "doc_size_budget": 40000,
  "real_corpus_path": null,

  "docs_dir": "docs",
  "code_map_cmd": null,
  "db_kind": null,
  "db_introspect_cmd": null,
  "migrations_path": null,

  "tracker": {
    "base_url": "https://github.com/cuongdinhngo/code-atlas",
    "project_key": "code-atlas",
    "cli": "gh",
    "read_mcp": null,
    "fields": ["description", "type", "labels", "parent", "priority"]
  },

  "cause_taxonomy": [
    "logic",
    "data",
    "config",
    "integration",
    "concurrency",
    "validation",
    "ui"
  ],

  "ticket_header_schema": {
    "Goal": "G",
    "Scope / Deliverables": "R",
    "Acceptance criteria": "AC",
    "Constraint": "C"
  }
}
