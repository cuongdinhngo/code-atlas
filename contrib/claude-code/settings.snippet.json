{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "code-atlas-poke",
            "if": "Edit(*.php)|Write(*.php)",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
