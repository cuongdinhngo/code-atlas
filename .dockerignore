# Keep the build context small and the image reproducible: nothing host-, editor-, or
# artifact-specific, and never the resolved dependency trees (rebuilt inside the image).
.claude
# `.git` is kept: the container gate's R7.3 check needs `origin/main` (323). Local lifecycle
# scratch stays out anyway — it is git-ignored and only makes the context bigger.
.mango

# Python caches / build outputs
**/__pycache__
*.py[cod]
.venv
venv
*.egg-info
.pytest_cache
.pytest_full.log
.mypy_cache
.ruff_cache
build
dist

# Index artifacts and scale-timing outputs
.code-atlas
*.db
*.db-wal
*.db-shm
artifacts

# Resolved dependency trees — installed fresh in the image
adapters/php/vendor
node_modules

# Editors / OS
.idea
.vscode
.DS_Store
Thumbs.db
