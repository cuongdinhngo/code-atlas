# Keep the build context small and the image reproducible: nothing host-, editor-, or
# artifact-specific, and never the resolved dependency trees (rebuilt inside the image).
.claude
# `.git` is kept, minus its config: the container gate's R7.3 check needs `origin/main` (323). Local lifecycle
# scratch stays out anyway — it is git-ignored and only makes the context bigger.
.mango

# Secrets and keys (426): never in a build context or a layer
.env*
**/.env*
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
id_rsa*
**/id_rsa*
id_ed25519*
**/id_ed25519*
.mcp.json
**/.mcp.json
# A remote's token or credential helper lives here; the refs the gate's R7.3 check reads stay.
.git/config

# Python caches / build outputs
**/__pycache__
*.py[cod]
.venv
venv
*.egg-info
.pytest_cache
.pytest_full.log
.mypy_cache
.ruff_cache
build
dist

# Index artifacts and scale-timing outputs
.code-atlas
*.db
*.db-wal
*.db-shm
artifacts

# Resolved dependency trees — installed fresh in the image
adapters/php/vendor
node_modules

# Editors / OS
.idea
.vscode
.DS_Store
Thumbs.db
